# Copy to .env and adjust. Every value below is the default used when the variable is not set.

# PostgreSQL connection string for the backend (must not be empty).
# Its Username/Password must match POSTGRES_USER/POSTGRES_PASSWORD below.
ConnectionStrings__Default=Host=db;Port=5432;Database=admission;Username=admission;Password=admission

# How long a seat hold lasts before it expires, in seconds (positive whole number).
HOLD_DURATION_SECONDS=600

# How often the background job marks overdue holds as EXPIRED, in seconds (positive whole number).
EXPIRY_SWEEP_INTERVAL_SECONDS=5

# Frontend origins allowed to call the backend: comma-separated http(s) URLs without a path.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Backend URL for the frontend. It is a build arg baked in at build time: after changing it, run `docker compose up --build`.
VITE_API_BASE_URL=http://localhost:8080

# PostgreSQL superuser, password and default database created by the `db` service.
POSTGRES_USER=admission
POSTGRES_PASSWORD=admission
POSTGRES_DB=admission

# Connection used only by backend tests (`docker compose run --rm backend-tests`). Informational: compose builds
# it from POSTGRES_USER/POSTGRES_PASSWORD, so editing it here has no effect; override it per run with
# `docker compose run --rm -e TEST_DB_CONNECTION=... backend-tests`. The database must be `admission_test`,
# which the tests drop and recreate.
TEST_DB_CONNECTION=Host=db;Port=5432;Database=admission_test;Username=admission;Password=admission
